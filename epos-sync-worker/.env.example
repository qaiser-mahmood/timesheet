# Epos Now Credentials
EPOS_USERNAME=your_epos_username@example.com
EPOS_PASSWORD=your_epos_password_here

# Telegram 2FA & Notification Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Supabase Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Whitelist (Optional, comma-separated)
AUTHORIZED_MANAGERS=manager1@example.com,manager2@example.com

# Service & Scheduling Config
PORT=3000
TIMEZONE=Australia/Perth
OPERATING_START_HOUR=9
OPERATING_END_HOUR=20
PEAK_START_HOUR=11
PEAK_END_HOUR=15
PEAK_INTERVAL_MINUTES=5
OFFPEAK_INTERVAL_MINUTES=15

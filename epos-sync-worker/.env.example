# Epos Now Credentials
EPOS_USERNAME=your_epos_username@example.com
EPOS_PASSWORD=your_epos_password_here

# Telegram 2FA & Notification Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Supabase Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Whitelist (Optional, comma-separated)
AUTHORIZED_MANAGERS=manager1@example.com,manager2@example.com

# Service Config
PORT=3000
TZ=Australia/Perth
CRON_SCHEDULE=*/15 9-21 * * *
